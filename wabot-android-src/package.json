{
  "name": "wabot-android",
  "version": "2.1.0",
  "description": "Wabot embedded Android — vrai bot WABOT via nodejs-mobile",
  "main": "main.js",
  "scripts": {
    "build": "node -e \"const {execSync}=require('child_process');try{execSync('npx esbuild main.js --bundle --platform=node --format=cjs --outfile=bundle.js --external:bufferutil --external:utf-8-validate --external:canvas --external:gtts --external:file-type --external:@google-cloud/text-to-speech --external:ffmpeg-static --external:@ffmpeg/ffmpeg --alias:fluent-ffmpeg=./android-mocks/ffmpeg.js --alias:sharp=./android-mocks/sharp.js --alias:puppeteer=./android-mocks/puppeteer.js --alias:bcrypt=./android-mocks/bcrypt.js --alias:ytdl-core=./android-mocks/ytdl.js --log-limit=0',{stdio:\\'inherit\\'});console.log(\\'Bundle OK\\');}catch(e){console.error(\\'esbuild failed:\\',e.message);process.exit(1);}\""
  },
  "dependencies": {
    "@peculiar/webcrypto": "^1.4.5",
    "@supabase/supabase-js": "^2.58.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.4",
    "axios": "^1.12.2",
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "node-fetch": "^2.7.0",
    "dotenv": "^16.6.1",
    "chalk": "^4.1.2",
    "i18next": "^23.0.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "awesome-phonenumber": "^5.11.0",
    "libphonenumber-js": "^1.12.15",
    "yt-search": "^2.13.1",
    "cheerio": "^1.1.2",
    "jimp": "^1.6.0",
    "node-cache": "^5.1.2",
    "bcryptjs": "^3.0.2",
    "uuid": "^9.0.0",
    "async-mutex": "^0.5.0",
    "lru-cache": "^11.2.2",
    "memoizee": "^0.4.17"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}